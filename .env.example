# Which Claude model the LLM box uses: claude-haiku-5-5, claude-sonnet-5-5, or claude-opus-5-5.
MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=

# Fault injection: this bridge call and the next one fail, then Ableton answers again. Leave unset for normal use.
# BRIDGE_FAIL_AT=3

# Tags each session for an A/B comparison in feedback.py.
# VARIANT=A

# A/B on the main model: each session picks one at random. feedback.py compares them.
# AB_MODELS=claude-haiku-5-5,claude-sonnet-5-5
